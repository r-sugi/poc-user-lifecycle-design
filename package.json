{
  "name": "poc-user-lifecycle-design",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "$npm_execpath run build && vite preview",
    "deploy": "$npm_execpath run build && wrangler deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "lint": "biome check .",
    "format": "biome check --write .",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply poc-user-lifecycle --local",
    "seed": "tsx scripts/seed.ts",
    "typegen": "wrangler types --env-interface CloudflareBindings"
  },
  "dependencies": {
    "@hono/valibot-validator": "^0.6.1",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "drizzle-orm": "^0.44.6",
    "hono": "^4.13.1",
    "valibot": "^1.4.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.5",
    "@cloudflare/vite-plugin": "^1.51.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.2.0",
    "better-sqlite3": "^11.8.1",
    "drizzle-kit": "^0.31.4",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.11",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vite-ssr-components": "^0.6.1",
    "wrangler": "^4.120.0"
  },
  "allowScripts": {
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.1": true,
    "better-sqlite3@11.8.1": true,
    "fsevents@2.3.3": true,
    "workerd@1.20260801.1": true
  }
}
